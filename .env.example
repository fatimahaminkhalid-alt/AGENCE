# Copy this file to .env.local and fill in the values.
# Never upload .env.local to GitHub.

# Resend API key (resend.com) for sending contact-form messages by email.
# If you leave it empty, messages only print in the terminal (development mode).
RESEND_API_KEY=

# The email address that receives the messages
CONTACT_TO_EMAIL=

# The sender address (must be on a domain verified in Resend)
CONTACT_FROM_EMAIL=AGENCE <noreply@your-domain.sa>
